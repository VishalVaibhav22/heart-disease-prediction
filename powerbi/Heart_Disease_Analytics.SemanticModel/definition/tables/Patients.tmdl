		annotation SummarizationSetBy = Automatic

	column 'Age Group Sort' =
			
			SWITCH(
			    TRUE(),
			    ISBLANK(Patients[age]), 4,
			    Patients[age] <= 40, 1,
			    Patients[age] <= 55, 2,
			    3
			)
		formatString: 0
		lineageTag: 5aa1be01-1a46-4f19-8466-d3168f3f8039
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	partition Patients = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(AnalysisDataFolder & "\powerbi_patients.csv"),[Delimiter=",", Columns=26, Encoding=65001, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"patient_id", Int64.Type}, {"age", Int64.Type}, {"sex", Int64.Type}, {"cp", Int64.Type}, {"trestbps", Int64.Type}, {"chol", Int64.Type}, {"fbs", Int64.Type}, {"restecg", Int64.Type}, {"thalach", Int64.Type}, {"exang", Int64.Type}, {"oldpeak", type number}, {"slope", Int64.Type}, {"ca", Int64.Type}, {"thal", Int64.Type}, {"diagnosis_num", Int64.Type}, {"source", type text}, {"heart_disease", Int64.Type}, {"sex_label", type text}, {"cp_label", type text}, {"heart_disease_label", type text}, {"age_group", type text}, {"fbs_label", type logical}, {"restecg_label", type text}, {"exang_label", type text}, {"slope_label", type text}, {"thal_label", type text}})
				in
				    #"Changed Type"

	changedProperty = Name

	annotation PBI_ResultType = Table

