table Patients
	lineageTag: 95c99a6e-2d1a-4adc-a2db-4bfdd3c405da

	measure 'Total Patients' =
			
			DISTINCTCOUNT(Patients[patient_id])
		formatString: 0
		lineageTag: b7d5c1b5-3b25-49e7-ad19-4f8eaa9474c5

	measure 'Disease Cases' =
			
			CALCULATE(
			    [Total Patients],
			    Patients[heart_disease] = 1
			)
		formatString: 0
		lineageTag: fb121824-17d9-4396-8681-8f2cac088b85

	measure 'Disease Rate' =
			
			DIVIDE(
			    [Disease Cases],
			    [Total Patients],
			    0
			)
		formatString: 0.0%
		lineageTag: 7488e84a-517f-4155-9a65-5e89c1f6d498

	measure 'Average Age' =
			
			AVERAGE(Patients[age])
		formatString: 0.0
		lineageTag: 159a9a02-e30d-45f2-9d47-03bd08033bd4

	column patient_id
		dataType: int64
		formatString: 0
		lineageTag: 376197af-4ef3-478b-8e2c-60ace33c1cd9
		summarizeBy: sum
		sourceColumn: patient_id

		annotation SummarizationSetBy = Automatic

	column age
